rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ملفات الأعضاء: القراءة لأي عضو مسجّل، والتعديل لصاحب الحساب فقط
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // أسماء المستخدمين (فريدة): إنشاء فقط، لا يمكن تعديل اسم محجوز
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && name.matches('^[a-z0-9_]{3,20}$');
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // المحادثات: معرّف المحادثة = uidA_uidB مرتبين، ولا يصل إليها إلا طرفاها
    match /chats/{cid} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.members.size() == 2
                    && cid.split('_').hasAll(request.resource.data.members);
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.members
                    && request.resource.data.members == resource.data.members;
      allow delete: if false;

      match /messages/{mid} {
        allow read: if request.auth != null && request.auth.uid in cid.split('_');
        allow create: if request.auth != null
                      && request.auth.uid in cid.split('_')
                      && request.resource.data.from == request.auth.uid
                      && request.resource.data.type in ['text', 'image', 'voice']
                      && request.resource.data.keys().hasAll(['from', 'type', 'at']);
        allow update, delete: if false;
      }
    }
  }
}
